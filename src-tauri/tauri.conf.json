{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mutfak Sync",
  "version": "0.1.1",
  "identifier": "com.mutfakajans.sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mutfak Sync",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/rclone"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Turkish",
          "English"
        ]
      }
    },
    "resources": {
      "../docs/licenses/": "licenses/"
    }
  }
}
